{
  "name": "RFP - Verify OCR Requirement",
  "description": "OCR verification card with a page-image crop; records the verified text and resumes the pipeline.",
  "modernflowtype": 0,
  "environmentVariables": [
    "hrs_EscalateAfter",
    "hrs_PilotRecipientUpn",
    "hrs_ReminderAfter",
    "hrs_SharePointSiteUrl"
  ],
  "clientdata": {
    "properties": {
      "connectionReferences": {
        "shared_commondataserviceforapps": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_dataverseconnection"
          },
          "api": {
            "name": "shared_commondataserviceforapps"
          }
        },
        "shared_sharepointonline": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_sharepointconnection"
          },
          "api": {
            "name": "shared_sharepointonline"
          }
        },
        "shared_teams": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_teamsconnection"
          },
          "api": {
            "name": "shared_teams"
          }
        },
        "{{tools:api}}": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_rfptoolsconnection"
          },
          "api": {
            "name": "{{tools:api}}"
          }
        }
      },
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          },
          "hrs_EscalateAfter (hrs_EscalateAfter)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_EscalateAfter"
            }
          },
          "hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_PilotRecipientUpn"
            }
          },
          "hrs_ReminderAfter (hrs_ReminderAfter)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_ReminderAfter"
            }
          },
          "hrs_SharePointSiteUrl (hrs_SharePointSiteUrl)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_SharePointSiteUrl"
            }
          }
        },
        "triggers": {
          "When_a_row_changes": {
            "type": "OpenApiConnectionWebhook",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "SubscribeWebhookTrigger",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "subscriptionRequest/message": 1,
                "subscriptionRequest/entityname": "hrs_flag",
                "subscriptionRequest/scope": 4,
                "subscriptionRequest/runas": 1
              }
            },
            "conditions": [
              {
                "expression": "@equals(triggerOutputs()?['body/hrs_flagtype'], 431200153)"
              }
            ]
          }
        },
        "actions": {
          "Init_Response": {
            "type": "InitializeVariable",
            "inputs": {
              "variables": [
                {
                  "name": "Response",
                  "type": "object",
                  "value": {}
                }
              ]
            },
            "runAfter": {}
          },
          "Flag": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_flags",
                "recordId": "@triggerOutputs()?['body/hrs_flagid']"
              }
            },
            "runAfter": {
              "Init_Response": [
                "Succeeded"
              ]
            }
          },
          "Requirement": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_requirements",
                "recordId": "@body('Flag')?['_hrs_requirement_value']",
                "$expand": "hrs_rfp($select=hrs_rfpid,hrs_rfpkey),hrs_sourceblock($select=hrs_polygon,hrs_pagenumber)"
              }
            },
            "runAfter": {
              "Flag": [
                "Succeeded"
              ]
            }
          },
          "Base_Revision": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfprevisions",
                "$select": "hrs_sourcedocument",
                "$filter": "_hrs_rfp_value eq @{body('Requirement')?['hrs_rfp']?['hrs_rfpid']} and hrs_revisionnumber eq 0"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "Requirement": [
                "Succeeded"
              ]
            }
          },
          "Source": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "operationId": "GetFileContentByPath",
                "connectionName": "shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hrs_SharePointSiteUrl (hrs_SharePointSiteUrl)')",
                "path": "@{first(body('Base_Revision')?['value'])?['hrs_sourcedocument']}",
                "inferContentType": false
              }
            },
            "runAfter": {
              "Base_Revision": [
                "Succeeded"
              ]
            }
          },
          "Crop": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/{{tools:api}}",
                "operationId": "OcrCrop",
                "connectionName": "{{tools:api}}"
              },
              "parameters": {
                "body": {
                  "contentBase64": "@body('Source')?['$content']",
                  "regions": "@{body('Requirement')?['hrs_sourceblock']?['hrs_polygon']}"
                }
              }
            },
            "limit": {
              "timeout": "PT10M"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S"
            },
            "runAfter": {
              "Source": [
                "Succeeded"
              ]
            }
          },
          "Card": {
            "type": "Compose",
            "inputs": {
              "type": "AdaptiveCard",
              "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
              "version": "1.4",
              "body": [
                {
                  "type": "TextBlock",
                  "size": "Medium",
                  "weight": "Bolder",
                  "text": "Please verify text read from a scanned page"
                },
                {
                  "type": "FactSet",
                  "facts": [
                    {
                      "title": "Requirement",
                      "value": "@{body('Requirement')?['hrs_reqid']}"
                    },
                    {
                      "title": "Location",
                      "value": "@{body('Requirement')?['hrs_location']}"
                    },
                    {
                      "title": "Why",
                      "value": "@{body('Flag')?['hrs_detail']}"
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "weight": "Bolder",
                  "text": "The page"
                },
                {
                  "type": "Image",
                  "url": "@{concat('data:image/jpeg;base64,', body('Crop')?['jpegBase64'])}",
                  "altText": "Scanned page crop"
                },
                {
                  "type": "TextBlock",
                  "weight": "Bolder",
                  "text": "Text read by OCR (correct it if it differs from the page)"
                },
                {
                  "type": "Input.Text",
                  "id": "text",
                  "isMultiline": true,
                  "value": "@{body('Requirement')?['hrs_requirementtext']}"
                }
              ],
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Text is correct",
                  "data": {
                    "decision": "confirm"
                  }
                },
                {
                  "type": "Action.Submit",
                  "title": "Save my correction",
                  "data": {
                    "decision": "correct"
                  }
                }
              ]
            },
            "runAfter": {
              "Crop": [
                "Succeeded"
              ]
            }
          },
          "Ask": {
            "type": "OpenApiConnectionWebhook",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                "operationId": "PostCardAndWaitForResponse",
                "connectionName": "shared_teams"
              },
              "parameters": {
                "poster": "Flow bot",
                "location": "Chat with Flow bot",
                "body/body/messageBody": "@{string(outputs('Card'))}",
                "body/body/updateMessage": "Thanks - recorded.",
                "body/body/recipient/to": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')"
              }
            },
            "limit": {
              "timeout": "@parameters('hrs_ReminderAfter (hrs_ReminderAfter)')"
            },
            "runAfter": {
              "Card": [
                "Succeeded"
              ]
            }
          },
          "Got_Ask": {
            "type": "SetVariable",
            "inputs": {
              "name": "Response",
              "value": "@body('Ask')"
            },
            "runAfter": {
              "Ask": [
                "Succeeded"
              ]
            }
          },
          "Reminder": {
            "type": "Scope",
            "actions": {
              "Reminder_Note": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostMessageToConversation",
                    "connectionName": "shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                    "body/messageBody": "@{concat('<p>Reminder: the OCR text of requirement ', body('Requirement')?['hrs_reqid'], ' is waiting for verification; the run is paused until it is checked.</p>')}"
                  }
                },
                "runAfter": {}
              },
              "Remind": {
                "type": "OpenApiConnectionWebhook",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostCardAndWaitForResponse",
                    "connectionName": "shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/body/messageBody": "@{string(outputs('Card'))}",
                    "body/body/updateMessage": "Thanks - recorded.",
                    "body/body/recipient/to": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')"
                  }
                },
                "limit": {
                  "timeout": "@parameters('hrs_EscalateAfter (hrs_EscalateAfter)')"
                },
                "runAfter": {
                  "Reminder_Note": [
                    "Succeeded"
                  ]
                }
              },
              "Got_Remind": {
                "type": "SetVariable",
                "inputs": {
                  "name": "Response",
                  "value": "@body('Remind')"
                },
                "runAfter": {
                  "Remind": [
                    "Succeeded"
                  ]
                }
              },
              "Escalation": {
                "type": "Scope",
                "actions": {
                  "Escalation_Note": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                        "operationId": "PostMessageToConversation",
                        "connectionName": "shared_teams"
                      },
                      "parameters": {
                        "poster": "Flow bot",
                        "location": "Chat with Flow bot",
                        "body/recipient": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                        "body/messageBody": "@{concat('<p>Escalated: the OCR text of requirement ', body('Requirement')?['hrs_reqid'], ' has not been verified. The run stays paused; it never accepts OCR text by default.</p>')}"
                      }
                    },
                    "runAfter": {}
                  },
                  "Escalate": {
                    "type": "OpenApiConnectionWebhook",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                        "operationId": "PostCardAndWaitForResponse",
                        "connectionName": "shared_teams"
                      },
                      "parameters": {
                        "poster": "Flow bot",
                        "location": "Chat with Flow bot",
                        "body/body/messageBody": "@{string(outputs('Card'))}",
                        "body/body/updateMessage": "Thanks - recorded.",
                        "body/body/recipient/to": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')"
                      }
                    },
                    "limit": {
                      "timeout": "@parameters('hrs_EscalateAfter (hrs_EscalateAfter)')"
                    },
                    "runAfter": {
                      "Escalation_Note": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Got_Escalate": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "Response",
                      "value": "@body('Escalate')"
                    },
                    "runAfter": {
                      "Escalate": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Remind": [
                    "TimedOut",
                    "Failed"
                  ]
                }
              }
            },
            "runAfter": {
              "Ask": [
                "TimedOut",
                "Failed"
              ]
            }
          },
          "Flag_Now": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_flags",
                "$select": "hrs_flagid",
                "$filter": "hrs_flagid eq @{triggerOutputs()?['body/hrs_flagid']}"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "Got_Ask": [
                "Succeeded",
                "Skipped",
                "Failed",
                "TimedOut"
              ],
              "Reminder": [
                "Succeeded",
                "Skipped",
                "Failed",
                "TimedOut"
              ]
            }
          },
          "If_withdrawn": {
            "type": "If",
            "expression": {
              "equals": [
                "@length(body('Flag_Now')?['value'])",
                0
              ]
            },
            "actions": {
              "Tell_Withdrawn": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostMessageToConversation",
                    "connectionName": "shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                    "body/messageBody": "@{concat('<p>The verification card for requirement ', body('Requirement')?['hrs_reqid'], ' was withdrawn because the run was reprocessed; nothing was recorded.</p>')}"
                  }
                },
                "runAfter": {}
              },
              "Withdrawn_Stop": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                },
                "runAfter": {
                  "Tell_Withdrawn": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Flag_Now": [
                "Succeeded"
              ]
            }
          },
          "If_unanswered": {
            "type": "If",
            "expression": {
              "equals": [
                "@not(empty(variables('Response')))",
                false
              ]
            },
            "actions": {
              "Log_Overdue": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_runlogs",
                    "item/hrs_name": "@{concat('Verification overdue ', body('Requirement')?['hrs_reqid'])}",
                    "item/hrs_rfp@odata.bind": "hrs_rfps(@{body('Requirement')?['hrs_rfp']?['hrs_rfpid']})",
                    "item/hrs_stage": 2,
                    "item/hrs_status": 431200182,
                    "item/hrs_startedon": "@{utcNow()}",
                    "item/hrs_completedon": "@{utcNow()}",
                    "item/hrs_errordetail": "@{concat('No verification of ', body('Requirement')?['hrs_reqid'], ' after the reminder and escalation; the flag stays open and the run waits.')}"
                  }
                },
                "runAfter": {}
              },
              "Overdue_Stop": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                },
                "runAfter": {
                  "Log_Overdue": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "If_withdrawn": [
                "Succeeded"
              ]
            }
          },
          "If_corrected": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@variables('Response')?['data']?['decision']",
                    "correct"
                  ]
                },
                {
                  "not": {
                    "equals": [
                      "@trim(coalesce(variables('Response')?['data']?['text'], ''))",
                      ""
                    ]
                  }
                },
                {
                  "not": {
                    "equals": [
                      "@trim(coalesce(variables('Response')?['data']?['text'], ''))",
                      "@body('Requirement')?['hrs_requirementtext']"
                    ]
                  }
                }
              ]
            },
            "actions": {
              "Save_Correction": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_requirements",
                    "recordId": "@body('Flag')?['_hrs_requirement_value']",
                    "item/hrs_requirementtext": "@{trim(variables('Response')?['data']?['text'])}"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "If_unanswered": [
                "Succeeded"
              ]
            }
          },
          "Resolve_Flag": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "UpdateOnlyRecord",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_flags",
                "recordId": "@triggerOutputs()?['body/hrs_flagid']",
                "item/hrs_resolvedon": "@{utcNow()}",
                "item/hrs_resolvedby": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                "item/hrs_detail": "@{concat(body('Flag')?['hrs_detail'], ' Verified: ', variables('Response')?['data']?['decision'], '.')}"
              }
            },
            "runAfter": {
              "If_corrected": [
                "Succeeded"
              ]
            }
          },
          "Still_open": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_flags",
                "$select": "hrs_flagid",
                "$filter": "_hrs_rfp_value eq @{body('Requirement')?['hrs_rfp']?['hrs_rfpid']} and hrs_flagtype eq 431200153 and hrs_resolvedon eq null"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "Resolve_Flag": [
                "Succeeded"
              ]
            }
          },
          "RFP_Now": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "recordId": "@{body('Requirement')?['hrs_rfp']?['hrs_rfpid']}"
              }
            },
            "runAfter": {
              "Still_open": [
                "Succeeded"
              ]
            }
          },
          "If_all_verified": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@length(body('Still_open')?['value'])",
                    0
                  ]
                },
                {
                  "equals": [
                    "@body('RFP_Now')?['hrs_status']",
                    431200172
                  ]
                },
                {
                  "equals": [
                    "@body('RFP_Now')?['hrs_stage']",
                    2
                  ]
                }
              ]
            },
            "actions": {
              "Resume_Pipeline": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_rfps",
                    "recordId": "@{body('Requirement')?['hrs_rfp']?['hrs_rfpid']}",
                    "item/hrs_status": 431200171
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "RFP_Now": [
                "Succeeded"
              ]
            }
          }
        },
        "outputs": {}
      },
      "templateName": ""
    },
    "schemaVersion": "1.0.0.0"
  }
}
