{
  "name": "RFP - Hook Pre Tool Use",
  "description": "Hook: deny an RFP rerun while the pipeline is running, after filing, or for a stage outside 1-9.",
  "modernflowtype": 1,
  "environmentVariables": [],
  "clientdata": {
    "properties": {
      "connectionReferences": {
        "shared_commondataserviceforapps": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_dataverseconnection"
          },
          "api": {
            "name": "shared_commondataserviceforapps"
          }
        },
        "{{tools:api}}": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_rfptoolsconnection"
          },
          "api": {
            "name": "{{tools:api}}"
          }
        }
      },
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          }
        },
        "triggers": {
          "manual": {
            "type": "Request",
            "kind": "Skills",
            "inputs": {
              "schema": {
                "type": "object",
                "required": [
                  "event",
                  "timestamp",
                  "metadata",
                  "toolName",
                  "parameters"
                ],
                "properties": {
                  "event": {
                    "title": "event",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "timestamp": {
                    "title": "timestamp",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "metadata": {
                    "title": "metadata",
                    "type": "object",
                    "x-ms-dynamically-added": true
                  },
                  "toolName": {
                    "title": "toolName",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "parameters": {
                    "title": "parameters",
                    "type": "object",
                    "x-ms-dynamically-added": true
                  }
                }
              }
            }
          }
        },
        "actions": {
          "RFP": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "$select": "hrs_rfpid,hrs_rfpkey,hrs_stage,hrs_status",
                "$filter": "hrs_rfpkey eq '@{trim(string(coalesce(triggerBody()?['parameters']?['rfpKey'], '')))}'"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {}
          },
          "Check": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/{{tools:api}}",
                "operationId": "OrchestratorRerunCheck",
                "connectionName": "{{tools:api}}"
              },
              "parameters": {
                "body": {
                  "rfp": "@first(body('RFP')?['value'])",
                  "stage": "@{triggerBody()?['parameters']?['stage']}"
                }
              }
            },
            "limit": {
              "timeout": "PT10M"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S"
            },
            "runAfter": {
              "RFP": [
                "Succeeded"
              ]
            }
          },
          "If_denied": {
            "type": "If",
            "expression": {
              "equals": [
                "@and(contains(toLower(coalesce(triggerBody()?['toolName'], '')), 'rerun'), not(equals(body('Check')?['allowed'], true)))",
                true
              ]
            },
            "actions": {
              "If_rfp": {
                "type": "If",
                "expression": {
                  "greater": [
                    "@length(body('RFP')?['value'])",
                    0
                  ]
                },
                "actions": {
                  "Audit_Denied_RFP": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "CreateRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_runlogs",
                        "item/hrs_name": "@{concat('Tool call denied: ', triggerBody()?['toolName'])}",
                        "item/hrs_status": 431200181,
                        "item/hrs_startedon": "@{utcNow()}",
                        "item/hrs_completedon": "@{utcNow()}",
                        "item/hrs_correlationid": "@{take(coalesce(triggerBody()?['metadata']?['conversationId'], ''), 100)}",
                        "item/hrs_errordetail": "@{concat('Audit (RFP Orchestrator). Denied tool: ', triggerBody()?['toolName'], '; parameters: ', string(triggerBody()?['parameters']), '; reason: ', coalesce(body('Check')?['reason'], ''), '; user: ', coalesce(triggerBody()?['metadata']?['userAadObjectId'], 'not signed in'), '; channel: ', coalesce(triggerBody()?['metadata']?['channel'], ''), '; conversation: ', coalesce(triggerBody()?['metadata']?['conversationId'], ''), '.')}",
                        "item/hrs_rfp@odata.bind": "hrs_rfps(@{first(body('RFP')?['value'])?['hrs_rfpid']})"
                      }
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Audit_Denied": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "connectionName": "shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "hrs_runlogs",
                          "item/hrs_name": "@{concat('Tool call denied: ', triggerBody()?['toolName'])}",
                          "item/hrs_status": 431200181,
                          "item/hrs_startedon": "@{utcNow()}",
                          "item/hrs_completedon": "@{utcNow()}",
                          "item/hrs_correlationid": "@{take(coalesce(triggerBody()?['metadata']?['conversationId'], ''), 100)}",
                          "item/hrs_errordetail": "@{concat('Audit (RFP Orchestrator). Denied tool: ', triggerBody()?['toolName'], '; parameters: ', string(triggerBody()?['parameters']), '; reason: ', coalesce(body('Check')?['reason'], ''), '; user: ', coalesce(triggerBody()?['metadata']?['userAadObjectId'], 'not signed in'), '; channel: ', coalesce(triggerBody()?['metadata']?['channel'], ''), '; conversation: ', coalesce(triggerBody()?['metadata']?['conversationId'], ''), '.')}"
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Check": [
                "Succeeded"
              ]
            }
          },
          "Respond": {
            "type": "Response",
            "kind": "Skills",
            "inputs": {
              "statusCode": 200,
              "body": {
                "permissionDecision": "@{if(and(contains(toLower(coalesce(triggerBody()?['toolName'], '')), 'rerun'), not(equals(body('Check')?['allowed'], true))), 'deny', '')}",
                "permissionDecisionReason": "@{if(and(contains(toLower(coalesce(triggerBody()?['toolName'], '')), 'rerun'), not(equals(body('Check')?['allowed'], true))), body('Check')?['reason'], '')}"
              },
              "schema": {
                "type": "object",
                "properties": {
                  "permissionDecision": {
                    "title": "permissionDecision",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "permissionDecisionReason": {
                    "title": "permissionDecisionReason",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "modifiedParameters": {
                    "title": "modifiedParameters",
                    "type": "object",
                    "x-ms-dynamically-added": true
                  },
                  "additionalContext": {
                    "title": "additionalContext",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "suppressOutput": {
                    "title": "suppressOutput",
                    "type": "boolean",
                    "x-ms-content-hint": "BOOLEAN",
                    "x-ms-dynamically-added": true
                  }
                }
              }
            },
            "runAfter": {
              "If_denied": [
                "Succeeded",
                "Failed"
              ]
            }
          }
        },
        "outputs": {}
      },
      "templateName": ""
    },
    "schemaVersion": "1.0.0.0"
  }
}
