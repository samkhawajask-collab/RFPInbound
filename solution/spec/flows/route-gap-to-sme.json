{
  "name": "RFP - Route Gap To SME",
  "description": "Gap card to the pilot recipient (Q6), waits with reminder and escalation, records the answer and proposes a Draft library entry.",
  "modernflowtype": 0,
  "environmentVariables": [
    "hrs_EscalateAfter",
    "hrs_PilotRecipientUpn",
    "hrs_ReminderAfter"
  ],
  "clientdata": {
    "properties": {
      "connectionReferences": {
        "shared_commondataserviceforapps": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_dataverseconnection"
          },
          "api": {
            "name": "shared_commondataserviceforapps"
          }
        },
        "shared_teams": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_teamsconnection"
          },
          "api": {
            "name": "shared_teams"
          }
        }
      },
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          },
          "hrs_EscalateAfter (hrs_EscalateAfter)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_EscalateAfter"
            }
          },
          "hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_PilotRecipientUpn"
            }
          },
          "hrs_ReminderAfter (hrs_ReminderAfter)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_ReminderAfter"
            }
          }
        },
        "triggers": {
          "When_a_row_changes": {
            "type": "OpenApiConnectionWebhook",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "SubscribeWebhookTrigger",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "subscriptionRequest/message": 1,
                "subscriptionRequest/entityname": "hrs_gap",
                "subscriptionRequest/scope": 4,
                "subscriptionRequest/runas": 1
              }
            },
            "conditions": [
              {
                "expression": "@equals(triggerOutputs()?['body/hrs_smestatus'], 431200190)"
              }
            ]
          }
        },
        "actions": {
          "Init_Response": {
            "type": "InitializeVariable",
            "inputs": {
              "variables": [
                {
                  "name": "Response",
                  "type": "object",
                  "value": {}
                }
              ]
            },
            "runAfter": {}
          },
          "Gap": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_gaps",
                "recordId": "@triggerOutputs()?['body/hrs_gapid']",
                "$expand": "hrs_routedtosme($select=hrs_smecode,hrs_name,hrs_email)"
              }
            },
            "runAfter": {
              "Init_Response": [
                "Succeeded"
              ]
            }
          },
          "Requirement": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_requirements",
                "recordId": "@body('Gap')?['_hrs_requirement_value']",
                "$expand": "hrs_rfp($select=hrs_rfpid,hrs_rfpkey,hrs_duedate),hrs_categorycode($select=hrs_categoryid,hrs_categorycode,hrs_name)"
              }
            },
            "runAfter": {
              "Gap": [
                "Succeeded"
              ]
            }
          },
          "Backup": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_categories",
                "recordId": "@{body('Requirement')?['hrs_categorycode']?['hrs_categoryid']}",
                "$select": "hrs_categorycode",
                "$expand": "hrs_backupsmeid($select=hrs_name)"
              }
            },
            "runAfter": {
              "Requirement": [
                "Succeeded"
              ]
            }
          },
          "Card": {
            "type": "Compose",
            "inputs": {
              "type": "AdaptiveCard",
              "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
              "version": "1.4",
              "body": [
                {
                  "type": "TextBlock",
                  "size": "Medium",
                  "weight": "Bolder",
                  "text": "No approved library answer - your input is needed"
                },
                {
                  "type": "FactSet",
                  "facts": [
                    {
                      "title": "Requirement",
                      "value": "@{body('Requirement')?['hrs_reqid']}"
                    },
                    {
                      "title": "Location",
                      "value": "@{body('Requirement')?['hrs_location']}"
                    },
                    {
                      "title": "Category",
                      "value": "@{body('Requirement')?['hrs_categorycode']?['hrs_name']}"
                    },
                    {
                      "title": "Routed to",
                      "value": "@{body('Gap')?['hrs_routedtosme']?['hrs_name']} (pilot delivery)"
                    },
                    {
                      "title": "Answer by",
                      "value": "@{body('Gap')?['hrs_dueby']}"
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "wrap": true,
                  "text": "@{body('Requirement')?['hrs_requirementtext']}"
                },
                {
                  "type": "Input.Text",
                  "id": "answer",
                  "isMultiline": true,
                  "placeholder": "Your answer for this proposal"
                }
              ],
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Submit answer",
                  "data": {
                    "decision": "answer"
                  }
                },
                {
                  "type": "Action.Submit",
                  "title": "Cannot answer",
                  "data": {
                    "decision": "cannot"
                  }
                }
              ]
            },
            "runAfter": {
              "Backup": [
                "Succeeded"
              ]
            }
          },
          "Ask": {
            "type": "OpenApiConnectionWebhook",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                "operationId": "PostCardAndWaitForResponse",
                "connectionName": "shared_teams"
              },
              "parameters": {
                "poster": "Flow bot",
                "location": "Chat with Flow bot",
                "body/body/messageBody": "@{string(outputs('Card'))}",
                "body/body/updateMessage": "Thanks - recorded.",
                "body/body/recipient/to": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')"
              }
            },
            "limit": {
              "timeout": "@parameters('hrs_ReminderAfter (hrs_ReminderAfter)')"
            },
            "runAfter": {
              "Card": [
                "Succeeded"
              ]
            }
          },
          "Got_Ask": {
            "type": "SetVariable",
            "inputs": {
              "name": "Response",
              "value": "@body('Ask')"
            },
            "runAfter": {
              "Ask": [
                "Succeeded"
              ]
            }
          },
          "Reminder": {
            "type": "Scope",
            "actions": {
              "Reminder_Note": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostMessageToConversation",
                    "connectionName": "shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                    "body/messageBody": "@{concat('<p>Reminder: requirement ', body('Requirement')?['hrs_reqid'], ' still needs an answer from ', body('Gap')?['hrs_routedtosme']?['hrs_name'], '.</p>')}"
                  }
                },
                "runAfter": {}
              },
              "Remind": {
                "type": "OpenApiConnectionWebhook",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostCardAndWaitForResponse",
                    "connectionName": "shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/body/messageBody": "@{string(outputs('Card'))}",
                    "body/body/updateMessage": "Thanks - recorded.",
                    "body/body/recipient/to": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')"
                  }
                },
                "limit": {
                  "timeout": "@parameters('hrs_EscalateAfter (hrs_EscalateAfter)')"
                },
                "runAfter": {
                  "Reminder_Note": [
                    "Succeeded"
                  ]
                }
              },
              "Got_Remind": {
                "type": "SetVariable",
                "inputs": {
                  "name": "Response",
                  "value": "@body('Remind')"
                },
                "runAfter": {
                  "Remind": [
                    "Succeeded"
                  ]
                }
              },
              "Escalation": {
                "type": "Scope",
                "actions": {
                  "Escalation_Note": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                        "operationId": "PostMessageToConversation",
                        "connectionName": "shared_teams"
                      },
                      "parameters": {
                        "poster": "Flow bot",
                        "location": "Chat with Flow bot",
                        "body/recipient": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                        "body/messageBody": "@{concat('<p>Escalated: no answer from ', body('Gap')?['hrs_routedtosme']?['hrs_name'], ' for requirement ', body('Requirement')?['hrs_reqid'], '. Backup SME: ', coalesce(body('Backup')?['hrs_backupsmeid']?['hrs_name'], 'none recorded'), ' (pilot delivery).</p>')}"
                      }
                    },
                    "runAfter": {}
                  },
                  "Escalate": {
                    "type": "OpenApiConnectionWebhook",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                        "operationId": "PostCardAndWaitForResponse",
                        "connectionName": "shared_teams"
                      },
                      "parameters": {
                        "poster": "Flow bot",
                        "location": "Chat with Flow bot",
                        "body/body/messageBody": "@{string(outputs('Card'))}",
                        "body/body/updateMessage": "Thanks - recorded.",
                        "body/body/recipient/to": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')"
                      }
                    },
                    "limit": {
                      "timeout": "@parameters('hrs_EscalateAfter (hrs_EscalateAfter)')"
                    },
                    "runAfter": {
                      "Escalation_Note": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Got_Escalate": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "Response",
                      "value": "@body('Escalate')"
                    },
                    "runAfter": {
                      "Escalate": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Remind": [
                    "TimedOut",
                    "Failed"
                  ]
                }
              }
            },
            "runAfter": {
              "Ask": [
                "TimedOut",
                "Failed"
              ]
            }
          },
          "Gap_Now": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_gaps",
                "$select": "hrs_gapid",
                "$filter": "hrs_gapid eq @{triggerOutputs()?['body/hrs_gapid']}"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "Got_Ask": [
                "Succeeded",
                "Skipped",
                "Failed",
                "TimedOut"
              ],
              "Reminder": [
                "Succeeded",
                "Skipped",
                "Failed",
                "TimedOut"
              ]
            }
          },
          "If_withdrawn": {
            "type": "If",
            "expression": {
              "equals": [
                "@length(body('Gap_Now')?['value'])",
                0
              ]
            },
            "actions": {
              "Tell_Withdrawn": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostMessageToConversation",
                    "connectionName": "shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "@parameters('hrs_PilotRecipientUpn (hrs_PilotRecipientUpn)')",
                    "body/messageBody": "@{concat('<p>The card for requirement ', body('Requirement')?['hrs_reqid'], ' was withdrawn because the run was reprocessed; nothing was recorded.</p>')}"
                  }
                },
                "runAfter": {}
              },
              "Withdrawn_Stop": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                },
                "runAfter": {
                  "Tell_Withdrawn": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Gap_Now": [
                "Succeeded"
              ]
            }
          },
          "If_responded": {
            "type": "If",
            "expression": {
              "equals": [
                "@not(empty(variables('Response')))",
                true
              ]
            },
            "actions": {
              "If_answered": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@variables('Response')?['data']?['decision']",
                        "answer"
                      ]
                    },
                    {
                      "not": {
                        "equals": [
                          "@trim(coalesce(variables('Response')?['data']?['answer'], ''))",
                          ""
                        ]
                      }
                    }
                  ]
                },
                "actions": {
                  "Record_Answer": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "UpdateOnlyRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_gaps",
                        "recordId": "@triggerOutputs()?['body/hrs_gapid']",
                        "item/hrs_smeanswertext": "@{variables('Response')?['data']?['answer']}",
                        "item/hrs_smestatus": 431200191
                      }
                    },
                    "runAfter": {}
                  },
                  "Existing_Proposal": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "ListRecords",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_answers",
                        "$select": "hrs_answerid,hrs_approvalstatus",
                        "$filter": "hrs_answercode eq '@{concat('PROP-', body('Requirement')?['hrs_rfp']?['hrs_rfpkey'], '-', body('Requirement')?['hrs_reqid'])}'"
                      }
                    },
                    "runtimeConfiguration": {
                      "paginationPolicy": {
                        "minimumItemCount": 5000
                      }
                    },
                    "runAfter": {
                      "Record_Answer": [
                        "Succeeded"
                      ]
                    }
                  },
                  "If_new_proposal": {
                    "type": "If",
                    "expression": {
                      "equals": [
                        "@length(body('Existing_Proposal')?['value'])",
                        0
                      ]
                    },
                    "actions": {
                      "Propose_Library_Entry": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "operationId": "CreateRecord",
                            "connectionName": "shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "hrs_answers",
                            "item/hrs_answercode": "@{concat('PROP-', body('Requirement')?['hrs_rfp']?['hrs_rfpkey'], '-', body('Requirement')?['hrs_reqid'])}",
                            "item/hrs_question": "@body('Requirement')?['hrs_requirementtext']",
                            "item/hrs_answertext": "@{variables('Response')?['data']?['answer']}",
                            "item/hrs_approvalstatus": 431200011,
                            "item/hrs_confidentiality": 431200020,
                            "item/hrs_answertype": 431200000,
                            "item/hrs_categorycode@odata.bind": "hrs_categories(@{body('Requirement')?['hrs_categorycode']?['hrs_categoryid']})",
                            "item/hrs_owneremail": "@{body('Gap')?['hrs_routedtosme']?['hrs_email']}"
                          }
                        },
                        "runAfter": {}
                      },
                      "Link_Proposal": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "operationId": "UpdateOnlyRecord",
                            "connectionName": "shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "hrs_gaps",
                            "recordId": "@triggerOutputs()?['body/hrs_gapid']",
                            "item/hrs_proposedanswer@odata.bind": "hrs_answers(@{body('Propose_Library_Entry')?['hrs_answerid']})"
                          }
                        },
                        "runAfter": {
                          "Propose_Library_Entry": [
                            "Succeeded"
                          ]
                        }
                      }
                    },
                    "else": {
                      "actions": {
                        "If_still_draft": {
                          "type": "If",
                          "expression": {
                            "equals": [
                              "@first(body('Existing_Proposal')?['value'])?['hrs_approvalstatus']",
                              431200011
                            ]
                          },
                          "actions": {
                            "Replace_Draft_Proposal": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "operationId": "UpdateOnlyRecord",
                                  "connectionName": "shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "hrs_answers",
                                  "recordId": "@{first(body('Existing_Proposal')?['value'])?['hrs_answerid']}",
                                  "item/hrs_question": "@body('Requirement')?['hrs_requirementtext']",
                                  "item/hrs_answertext": "@{variables('Response')?['data']?['answer']}"
                                }
                              },
                              "runAfter": {}
                            }
                          },
                          "else": {
                            "actions": {}
                          },
                          "runAfter": {}
                        },
                        "Link_Existing_Proposal": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "UpdateOnlyRecord",
                              "connectionName": "shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "hrs_gaps",
                              "recordId": "@triggerOutputs()?['body/hrs_gapid']",
                              "item/hrs_proposedanswer@odata.bind": "hrs_answers(@{first(body('Existing_Proposal')?['value'])?['hrs_answerid']})"
                            }
                          },
                          "runAfter": {
                            "If_still_draft": [
                              "Succeeded"
                            ]
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Existing_Proposal": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Record_Cannot": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord",
                          "connectionName": "shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "hrs_gaps",
                          "recordId": "@triggerOutputs()?['body/hrs_gapid']",
                          "item/hrs_smestatus": 431200192
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Record_Overdue": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hrs_gaps",
                      "recordId": "@triggerOutputs()?['body/hrs_gapid']",
                      "item/hrs_smestatus": 431200193
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": {
              "If_withdrawn": [
                "Succeeded"
              ]
            }
          },
          "Still_routed": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_gaps",
                "$select": "hrs_gapid",
                "$filter": "hrs_requirement/_hrs_rfp_value eq @{body('Requirement')?['hrs_rfp']?['hrs_rfpid']} and hrs_smestatus eq 431200190"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "If_responded": [
                "Succeeded",
                "Failed"
              ]
            }
          },
          "If_all_answered": {
            "type": "If",
            "expression": {
              "equals": [
                "@length(body('Still_routed')?['value'])",
                0
              ]
            },
            "actions": {
              "Resume_Pipeline": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_rfps",
                    "recordId": "@{body('Requirement')?['hrs_rfp']?['hrs_rfpid']}",
                    "item/hrs_status": 431200171
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Still_routed": [
                "Succeeded"
              ]
            }
          }
        },
        "outputs": {}
      },
      "templateName": ""
    },
    "schemaVersion": "1.0.0.0"
  }
}
