                  },
                  "parameters": {
                    "entityName": "hrs_answers",
                    "$select": "hrs_answerid",
                    "$filter": "startswith(hrs_answercode,'PROP-@{first(body('RFP')?['value'])?['hrs_rfpkey']}-') and hrs_approvalstatus eq 431200011 and createdon ge @{coalesce(first(body('Pass')?['value'])?['hrs_startedon'], utcNow())}"
                  }
                },
                "runtimeConfiguration": {
