              },
              "Rerun_Responses_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Responses')?['value']",
                "actions": {
                  "Rerun_Responses_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "DeleteRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_responses",
                        "recordId": "@items('Rerun_Responses_Each')?['hrs_responseid']"
                      }
