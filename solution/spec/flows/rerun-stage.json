                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {
                  "Rerun_Approvals_Each": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Clarifications_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Clarifications')?['value']",
                "actions": {
                  "Rerun_Clarifications_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "DeleteRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_clarifications",
                        "recordId": "@items('Rerun_Clarifications_Each')?['hrs_clarificationid']"
                      }
                    },
                    "runAfter": {}
                  }
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 20
                  }
                },
                "runAfter": {
                  "Rerun_Clarifications": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Gaps": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "ListRecords",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_gaps",
                    "$select": "hrs_gapid",
                    "$filter": "hrs_requirement/_hrs_rfp_value eq @{coalesce(first(body('RFP')?['value'])?['hrs_rfpid'], '00000000-0000-0000-0000-000000000000')} and createdon ge @{coalesce(first(body('Pass')?['value'])?['hrs_startedon'], utcNow())}"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {
                  "Rerun_Clarifications_Each": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Gaps_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Gaps')?['value']",
                "actions": {
                  "Rerun_Gaps_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "DeleteRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_gaps",
                        "recordId": "@items('Rerun_Gaps_Each')?['hrs_gapid']"
                      }
                    },
                    "runAfter": {}
                  }
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 20
                  }
                },
                "runAfter": {
                  "Rerun_Gaps": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Responses": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
