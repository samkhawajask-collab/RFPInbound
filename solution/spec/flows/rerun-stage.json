                    "Succeeded"
                  ]
                }
              },
              "Rerun_Documentblocks": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "ListRecords",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_documentblocks",
                    "$select": "hrs_documentblockid",
                    "$filter": "hrs_rfpdocument/hrs_rfprevision/_hrs_rfp_value eq @{coalesce(first(body('RFP')?['value'])?['hrs_rfpid'], '00000000-0000-0000-0000-000000000000')} and createdon ge @{coalesce(first(body('Pass')?['value'])?['hrs_startedon'], utcNow())}"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {
