              },
              "Rerun_Flags_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Flags')?['value']",
                "actions": {
                  "Rerun_Flags_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "DeleteRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_flags",
                        "recordId": "@items('Rerun_Flags_Each')?['hrs_flagid']"
                      }
                    },
                    "runAfter": {}
                  }
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 20
                  }
                },
                "runAfter": {
                  "Rerun_Flags": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Requirements": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "ListRecords",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_requirements",
                    "$select": "hrs_requirementid",
                    "$filter": "_hrs_rfp_value eq @{coalesce(first(body('RFP')?['value'])?['hrs_rfpid'], '00000000-0000-0000-0000-000000000000')} and createdon ge @{coalesce(first(body('Pass')?['value'])?['hrs_startedon'], utcNow())}"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {
                  "Rerun_Flags_Each": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Requirements_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Requirements')?['value']",
                "actions": {
                  "Rerun_Requirements_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "DeleteRecord",
                        "connectionName": "shared_commondataserviceforapps"
