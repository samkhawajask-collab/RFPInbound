{
  "name": "RFP - Rerun Stage",
  "description": "Rerun an RFP's pipeline from a stage (1-9). Refused while the pipeline is running or after the RFP is filed.",
  "modernflowtype": 1,
  "environmentVariables": [],
  "clientdata": {
    "properties": {
      "connectionReferences": {
        "shared_commondataserviceforapps": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_dataverseconnection"
          },
          "api": {
            "name": "shared_commondataserviceforapps"
          }
        },
        "{{tools:api}}": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_rfptoolsconnection"
          },
          "api": {
            "name": "{{tools:api}}"
          }
        }
      },
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          }
        },
        "triggers": {
          "manual": {
            "type": "Request",
            "kind": "Skills",
            "inputs": {
              "schema": {
                "type": "object",
                "required": [
                  "rfpKey",
                  "stage"
                ],
                "properties": {
                  "rfpKey": {
                    "title": "rfpKey",
                    "description": "The RFP's key, as the user gave it. The tool says if no RFP has that key",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "stage": {
                    "title": "stage",
                    "description": "The stage to rerun from, 1 to 9",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  }
                }
              }
            }
          }
        },
        "actions": {
          "RFP": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "$select": "hrs_rfpid,hrs_rfpkey,hrs_stage,hrs_status,hrs_currentrevision",
                "$filter": "hrs_rfpkey eq '@{trim(triggerBody()?['rfpKey'])}'"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {}
          },
          "Check": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/{{tools:api}}",
                "operationId": "OrchestratorRerunCheck",
                "connectionName": "{{tools:api}}"
              },
              "parameters": {
                "body": {
                  "rfp": "@first(body('RFP')?['value'])",
                  "stage": "@{triggerBody()?['stage']}"
                }
              }
            },
            "limit": {
              "timeout": "PT10M"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S"
            },
            "runAfter": {
              "RFP": [
                "Succeeded"
              ]
            }
          },
          "If_audit": {
            "type": "If",
            "expression": {
              "greater": [
                "@length(body('RFP')?['value'])",
                0
              ]
            },
            "actions": {
              "Audit_Tool_RFP": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_runlogs",
                    "item/hrs_name": "Tool run: RFP - Rerun Stage",
                    "item/hrs_status": 431200181,
                    "item/hrs_startedon": "@{utcNow()}",
                    "item/hrs_completedon": "@{utcNow()}",
                    "item/hrs_correlationid": "@{take(coalesce(triggerOutputs()?['headers']?['x-ms-client-session-id'], 'unknown'), 100)}",
                    "item/hrs_errordetail": "@{concat('Audit (RFP Orchestrator). Tool: RFP - Rerun Stage; parameters: ', string(triggerBody()), '; outcome: ', if(equals(body('Check')?['allowed'], true), 'allowed', concat('refused: ', body('Check')?['reason'])), '; caller: ', coalesce(triggerOutputs()?['headers']?['x-ms-object-id'], 'unknown'), '; client: ', coalesce(triggerOutputs()?['headers']?['x-ms-client-keywords'], 'unknown'), '; conversation: ', coalesce(triggerOutputs()?['headers']?['x-ms-client-session-id'], 'unknown'), '.')}",
                    "item/hrs_rfp@odata.bind": "hrs_rfps(@{first(body('RFP')?['value'])?['hrs_rfpid']})"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Audit_Tool": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hrs_runlogs",
                      "item/hrs_name": "Tool run: RFP - Rerun Stage",
                      "item/hrs_status": 431200181,
                      "item/hrs_startedon": "@{utcNow()}",
                      "item/hrs_completedon": "@{utcNow()}",
                      "item/hrs_correlationid": "@{take(coalesce(triggerOutputs()?['headers']?['x-ms-client-session-id'], 'unknown'), 100)}",
                      "item/hrs_errordetail": "@{concat('Audit (RFP Orchestrator). Tool: RFP - Rerun Stage; parameters: ', string(triggerBody()), '; outcome: ', if(equals(body('Check')?['allowed'], true), 'allowed', concat('refused: ', body('Check')?['reason'])), '; caller: ', coalesce(triggerOutputs()?['headers']?['x-ms-object-id'], 'unknown'), '; client: ', coalesce(triggerOutputs()?['headers']?['x-ms-client-keywords'], 'unknown'), '; conversation: ', coalesce(triggerOutputs()?['headers']?['x-ms-client-session-id'], 'unknown'), '.')}"
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": {
              "Check": [
                "Succeeded"
              ]
            }
          },
          "Respond_Not_Audited": {
            "type": "Response",
            "kind": "Skills",
            "inputs": {
              "statusCode": 200,
              "body": {
                "result": "Not rerun, and nothing was changed: the audit record could not be written. Trying again won't help until that is fixed. Ask an administrator to check the latest RFP - Rerun Stage flow run."
              },
              "schema": {
                "type": "object",
                "properties": {
                  "result": {
                    "title": "result",
                    "description": "The answer for the user",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  }
                }
              }
            },
            "runAfter": {
              "If_audit": [
                "Failed",
                "TimedOut"
              ]
            }
          },
          "If_allowed": {
            "type": "If",
            "expression": {
              "equals": [
                "@body('Check')?['allowed']",
                true
              ]
            },
            "actions": {
              "Respond_Started": {
                "type": "Response",
                "kind": "Skills",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "result": "@{concat(body('Check')?['reason'], ' The pipeline restarts once rows from the earlier pass are removed; ask for the run status to follow it.')}"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "result": {
                        "title": "result",
                        "description": "The answer for the user",
                        "type": "string",
                        "x-ms-content-hint": "TEXT",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                },
                "runAfter": {}
              },
              "Pass": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "ListRecords",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_runlogs",
                    "$select": "hrs_startedon",
                    "$filter": "_hrs_rfp_value eq @{coalesce(first(body('RFP')?['value'])?['hrs_rfpid'], '00000000-0000-0000-0000-000000000000')} and hrs_stage eq @{body('Check')?['fromStage']}",
                    "$orderby": "createdon desc",
                    "$top": 1
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {
                  "Respond_Started": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Approvals": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "ListRecords",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_approvals",
                    "$select": "hrs_approvalid",
                    "$filter": "_hrs_rfp_value eq @{coalesce(first(body('RFP')?['value'])?['hrs_rfpid'], '00000000-0000-0000-0000-000000000000')} and createdon ge @{coalesce(first(body('Pass')?['value'])?['hrs_startedon'], utcNow())}"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {
                  "Pass": [
                    "Succeeded"
                  ]
                }
              },
              "Rerun_Approvals_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Approvals')?['value']",
                "actions": {
                  "Rerun_Approvals_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
