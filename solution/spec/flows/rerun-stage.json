                }
              },
              "Rerun_Documentblocks_Each": {
                "type": "Foreach",
                "foreach": "@body('Rerun_Documentblocks')?['value']",
                "actions": {
                  "Rerun_Documentblocks_Delete": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "DeleteRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_documentblocks",
                        "recordId": "@items('Rerun_Documentblocks_Each')?['hrs_documentblockid']"
                      }
