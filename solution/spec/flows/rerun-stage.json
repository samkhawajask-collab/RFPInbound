                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_rfps",
                    "recordId": "@{coalesce(first(body('RFP')?['value'])?['hrs_rfpid'], '00000000-0000-0000-0000-000000000000')}",
                    "item/hrs_stage": "@sub(body('Check')?['fromStage'], 1)",
                    "item/hrs_status": 431200170,
                    "item/hrs_currentrevision": "@if(body('Check')?['resetRevision'], 0, first(body('RFP')?['value'])?['hrs_currentrevision'])"
                  }
                },
