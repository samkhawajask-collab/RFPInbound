{
  "name": "RFP - Hook Post Tool Use",
  "description": "Hook: write an audit row for every RFP Orchestrator tool call.",
  "modernflowtype": 1,
  "environmentVariables": [],
  "clientdata": {
    "properties": {
      "connectionReferences": {
        "shared_commondataserviceforapps": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_dataverseconnection"
          },
          "api": {
            "name": "shared_commondataserviceforapps"
          }
        }
      },
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          }
        },
        "triggers": {
          "manual": {
            "type": "Request",
            "kind": "Skills",
            "inputs": {
              "schema": {
                "type": "object",
                "required": [
                  "event",
                  "timestamp",
                  "metadata",
                  "toolName",
                  "parameters",
                  "result"
                ],
                "properties": {
                  "event": {
                    "title": "event",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "timestamp": {
                    "title": "timestamp",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "metadata": {
                    "title": "metadata",
                    "type": "object",
                    "x-ms-dynamically-added": true
                  },
                  "toolName": {
                    "title": "toolName",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "parameters": {
                    "title": "parameters",
                    "type": "object",
                    "x-ms-dynamically-added": true
                  },
                  "result": {
                    "title": "result",
                    "type": "object",
                    "x-ms-dynamically-added": true
                  }
                }
              }
            }
          }
        },
        "actions": {
          "RFP": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "$select": "hrs_rfpid",
                "$filter": "hrs_rfpkey eq '@{trim(string(coalesce(triggerBody()?['parameters']?['rfpKey'], '')))}'"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {}
          },
          "If_rfp": {
            "type": "If",
            "expression": {
              "greater": [
                "@length(body('RFP')?['value'])",
                0
              ]
            },
            "actions": {
              "Audit_RFP": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_runlogs",
                    "item/hrs_name": "@{concat('Tool call: ', triggerBody()?['toolName'])}",
                    "item/hrs_status": 431200181,
                    "item/hrs_startedon": "@{utcNow()}",
                    "item/hrs_completedon": "@{utcNow()}",
                    "item/hrs_correlationid": "@{take(coalesce(triggerBody()?['metadata']?['conversationId'], ''), 100)}",
                    "item/hrs_errordetail": "@{concat('Audit (RFP Orchestrator). Tool: ', triggerBody()?['toolName'], '; parameters: ', string(triggerBody()?['parameters']), '; user: ', coalesce(triggerBody()?['metadata']?['userAadObjectId'], 'not signed in'), '; channel: ', coalesce(triggerBody()?['metadata']?['channel'], ''), '; conversation: ', coalesce(triggerBody()?['metadata']?['conversationId'], ''), '.')}",
                    "item/hrs_rfp@odata.bind": "hrs_rfps(@{first(body('RFP')?['value'])?['hrs_rfpid']})"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Audit": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hrs_runlogs",
                      "item/hrs_name": "@{concat('Tool call: ', triggerBody()?['toolName'])}",
                      "item/hrs_status": 431200181,
                      "item/hrs_startedon": "@{utcNow()}",
                      "item/hrs_completedon": "@{utcNow()}",
                      "item/hrs_correlationid": "@{take(coalesce(triggerBody()?['metadata']?['conversationId'], ''), 100)}",
                      "item/hrs_errordetail": "@{concat('Audit (RFP Orchestrator). Tool: ', triggerBody()?['toolName'], '; parameters: ', string(triggerBody()?['parameters']), '; user: ', coalesce(triggerBody()?['metadata']?['userAadObjectId'], 'not signed in'), '; channel: ', coalesce(triggerBody()?['metadata']?['channel'], ''), '; conversation: ', coalesce(triggerBody()?['metadata']?['conversationId'], ''), '.')}"
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": {
              "RFP": [
                "Succeeded"
              ]
            }
          },
          "Respond": {
            "type": "Response",
            "kind": "Skills",
            "inputs": {
              "statusCode": 200,
              "body": {},
              "schema": {
                "type": "object",
                "properties": {
                  "modifiedResult": {
                    "title": "modifiedResult",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "additionalContext": {
                    "title": "additionalContext",
                    "type": "string",
                    "x-ms-content-hint": "TEXT",
                    "x-ms-dynamically-added": true
                  },
                  "suppressOutput": {
                    "title": "suppressOutput",
                    "type": "boolean",
                    "x-ms-content-hint": "BOOLEAN",
                    "x-ms-dynamically-added": true
                  }
                }
              }
            },
            "runAfter": {
              "If_rfp": [
                "Succeeded"
              ]
            }
          }
        },
        "outputs": {}
      },
      "templateName": ""
    },
    "schemaVersion": "1.0.0.0"
  }
}
