{
  "name": "RFP - Receive Inbound Document",
  "description": "New file in the Inbound folder -> hrs_rfp, revision 0 and document rows; starts the pipeline.",
  "modernflowtype": 1,
  "environmentVariables": [
    "hrs_DocumentLibraryId",
    "hrs_InboundLibraryUrl",
    "hrs_SharePointSiteUrl"
  ],
  "clientdata": {
    "properties": {
      "connectionReferences": {
        "shared_commondataserviceforapps": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_dataverseconnection"
          },
          "api": {
            "name": "shared_commondataserviceforapps"
          }
        },
        "shared_sharepointonline": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_sharepointconnection"
          },
          "api": {
            "name": "shared_sharepointonline"
          }
        },
        "{{tools:api}}": {
          "runtimeSource": "embedded",
          "connection": {
            "connectionReferenceLogicalName": "hrs_rfptoolsconnection"
          },
          "api": {
            "name": "{{tools:api}}"
          }
        }
      },
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          },
          "hrs_DocumentLibraryId (hrs_DocumentLibraryId)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_DocumentLibraryId"
            }
          },
          "hrs_InboundLibraryUrl (hrs_InboundLibraryUrl)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_InboundLibraryUrl"
            }
          },
          "hrs_SharePointSiteUrl (hrs_SharePointSiteUrl)": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
              "schemaName": "hrs_SharePointSiteUrl"
            }
          }
        },
        "triggers": {
          "When_a_file_is_created": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "operationId": "GetOnNewFileItems",
                "connectionName": "shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hrs_SharePointSiteUrl (hrs_SharePointSiteUrl)')",
                "table": "@parameters('hrs_DocumentLibraryId (hrs_DocumentLibraryId)')",
                "folderPath": "@parameters('hrs_InboundLibraryUrl (hrs_InboundLibraryUrl)')"
              }
            },
            "recurrence": {
              "frequency": "Minute",
              "interval": 1
            },
            "splitOn": "@triggerOutputs()?['body/value']"
          }
        },
        "actions": {
          "File": {
            "type": "Compose",
            "inputs": {
              "name": "@triggerOutputs()?['body/{FilenameWithExtension}']",
              "path": "@{concat('/', triggerOutputs()?['body/{FullPath}'])}"
            },
            "runAfter": {}
          },
          "Opportunities": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_opportunities",
                "$select": "hrs_opportunityid,hrs_opportunitycode,hrs_rfpkey,hrs_rfpnumber,hrs_buyer"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "File": [
                "Succeeded"
              ]
            }
          },
          "Opportunity_Shape": {
            "type": "Select",
            "inputs": {
              "from": "@body('Opportunities')?['value']",
              "select": {
                "id": "@item()?['hrs_opportunityid']",
                "rfpNumber": "@item()?['hrs_rfpnumber']",
                "buyer": "@item()?['hrs_buyer']",
                "rfpKey": "@item()?['hrs_rfpkey']"
              }
            },
            "runAfter": {
              "Opportunities": [
                "Succeeded"
              ]
            }
          },
          "Match": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/{{tools:api}}",
                "operationId": "MatchOpportunity",
                "connectionName": "{{tools:api}}"
              },
              "parameters": {
                "body": {
                  "fileName": "@{outputs('File')?['name']}",
                  "opportunities": "@body('Opportunity_Shape')"
                }
              }
            },
            "limit": {
              "timeout": "PT10M"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S"
            },
            "runAfter": {
              "Opportunity_Shape": [
                "Succeeded"
              ]
            }
          },
          "If_no_match": {
            "type": "If",
            "expression": {
              "equals": [
                "@body('Match')?['opportunityId']",
                null
              ]
            },
            "actions": {
              "No_match_stop": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "PipelineStopped",
                    "message": "@{concat('No opportunity matches ', outputs('File')?['name'])}"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Match": [
                "Succeeded"
              ]
            }
          },
          "Opportunity": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "GetItem",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_opportunities",
                "recordId": "@body('Match')?['opportunityId']",
                "$select": "hrs_rfpkey,hrs_duedate,hrs_qadeadline"
              }
            },
            "runAfter": {
              "If_no_match": [
                "Succeeded"
              ]
            }
          },
          "Existing_RFP": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "ListRecords",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "$select": "hrs_rfpid,hrs_stage,hrs_status",
                "$filter": "hrs_rfpkey eq '@{body('Opportunity')?['hrs_rfpkey']}'"
              }
            },
            "runtimeConfiguration": {
              "paginationPolicy": {
                "minimumItemCount": 5000
              }
            },
            "runAfter": {
              "Opportunity": [
                "Succeeded"
              ]
            }
          },
          "If_exists": {
            "type": "If",
            "expression": {
              "greater": [
                "@length(body('Existing_RFP')?['value'])",
                0
              ]
            },
            "actions": {
              "Existing_Revisions": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "ListRecords",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_rfprevisions",
                    "$select": "hrs_rfprevisionid",
                    "$filter": "_hrs_rfp_value eq @{first(body('Existing_RFP')?['value'])?['hrs_rfpid']}"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 5000
                  }
                },
                "runAfter": {}
              },
              "Create_Addendum_Revision": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_rfprevisions",
                    "item/hrs_name": "@{concat(body('Opportunity')?['hrs_rfpkey'], ' revision ', string(length(body('Existing_Revisions')?['value'])))}",
                    "item/hrs_rfp@odata.bind": "hrs_rfps(@{first(body('Existing_RFP')?['value'])?['hrs_rfpid']})",
                    "item/hrs_revisionnumber": "@length(body('Existing_Revisions')?['value'])",
                    "item/hrs_effectivedate": "@{utcNow('yyyy-MM-dd')}",
                    "item/hrs_sourcedocument": "@{outputs('File')?['path']}"
                  }
                },
                "runAfter": {
                  "Existing_Revisions": [
                    "Succeeded"
                  ]
                }
              },
              "Create_Addendum_Document": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hrs_rfpdocuments",
                    "item/hrs_name": "@{outputs('File')?['path']}",
                    "item/hrs_rfprevision@odata.bind": "hrs_rfprevisions(@{body('Create_Addendum_Revision')?['hrs_rfprevisionid']})",
                    "item/hrs_format": "@if(endsWith(toLower(outputs('File')?['name']), '.pdf'), 431200121, 431200120)",
                    "item/hrs_ocrused": false
                  }
                },
                "runAfter": {
                  "Create_Addendum_Revision": [
                    "Succeeded"
                  ]
                }
              },
              "If_past_stage_2": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "greater": [
                        "@int(coalesce(first(body('Existing_RFP')?['value'])?['hrs_stage'], 0))",
                        2
                      ]
                    },
                    {
                      "not": {
                        "equals": [
                          "@first(body('Existing_RFP')?['value'])?['hrs_status']",
                          431200171
                        ]
                      }
                    }
                  ]
                },
                "actions": {
                  "Reprocess_From_Stage_3": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "UpdateOnlyRecord",
                        "connectionName": "shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "hrs_rfps",
                        "recordId": "@{first(body('Existing_RFP')?['value'])?['hrs_rfpid']}",
                        "item/hrs_stage": 2,
                        "item/hrs_status": 431200171
                      }
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {}
                },
                "runAfter": {
                  "Create_Addendum_Document": [
                    "Succeeded"
                  ]
                }
              },
              "Addendum_recorded": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                },
                "runAfter": {
                  "If_past_stage_2": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Existing_RFP": [
                "Succeeded"
              ]
            }
          },
          "Create_RFP": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "CreateRecord",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "item/hrs_rfpkey": "@body('Opportunity')?['hrs_rfpkey']",
                "item/hrs_opportunityid@odata.bind": "hrs_opportunities(@{body('Match')?['opportunityId']})",
                "item/hrs_duedate": "@body('Opportunity')?['hrs_duedate']",
                "item/hrs_qadeadline": "@body('Opportunity')?['hrs_qadeadline']",
                "item/hrs_currentrevision": 0,
                "item/hrs_stage": 0,
                "item/hrs_status": 431200170
              }
            },
            "runAfter": {
              "If_exists": [
                "Succeeded"
              ]
            }
          },
          "Create_Revision": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "CreateRecord",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfprevisions",
                "item/hrs_name": "@{concat(body('Opportunity')?['hrs_rfpkey'], ' revision 0')}",
                "item/hrs_rfp@odata.bind": "hrs_rfps(@{body('Create_RFP')?['hrs_rfpid']})",
                "item/hrs_revisionnumber": 0,
                "item/hrs_effectivedate": "@{utcNow('yyyy-MM-dd')}",
                "item/hrs_sourcedocument": "@{outputs('File')?['path']}"
              }
            },
            "runAfter": {
              "Create_RFP": [
                "Succeeded"
              ]
            }
          },
          "Create_Document": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "CreateRecord",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfpdocuments",
                "item/hrs_name": "@{outputs('File')?['path']}",
                "item/hrs_rfprevision@odata.bind": "hrs_rfprevisions(@{body('Create_Revision')?['hrs_rfprevisionid']})",
                "item/hrs_format": "@if(endsWith(toLower(outputs('File')?['name']), '.pdf'), 431200121, 431200120)",
                "item/hrs_ocrused": false
              }
            },
            "runAfter": {
              "Create_Revision": [
                "Succeeded"
              ]
            }
          },
          "Start_Pipeline": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                "operationId": "UpdateOnlyRecord",
                "connectionName": "shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "hrs_rfps",
                "recordId": "@body('Create_RFP')?['hrs_rfpid']",
                "item/hrs_status": 431200171
              }
            },
            "runAfter": {
              "Create_Document": [
                "Succeeded"
              ]
            }
          }
        },
        "outputs": {}
      },
      "templateName": ""
    },
    "schemaVersion": "1.0.0.0"
  }
}
