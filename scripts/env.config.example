# Target environments for pac import/check (hard rule 3).
# Scripts must refuse to import into any URL not listed here.
# No tenant IDs, user names, secrets or tokens in this file (hard rule 4) - auth comes from the active pac/az profile.

# Development (unmanaged) - the only place solution changes are made
DEV_URL=
DEV_PAC_PROFILE=

# Test (managed) - slice acceptance + evaluation harness; holds gold data (ADR-0007, ADR-0009)
# Display name "proj ops lite". Same UNIVERSAL pac profile; target it with --environment $TEST_URL.
TEST_URL=
TEST_PAC_PROFILE=

# Azure resources for the rfp-tools service (dev). Names only - no keys, no subscription or tenant IDs.
# The subscription is whichever one the signed-in az account has active.
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=
AZURE_STORAGE_ACCOUNT=
AZURE_FUNCTION_APP=
# Document Intelligence (Layout) for the PDF paths; also its custom subdomain (ADR-0023)
AZURE_DOCINTEL=

# SharePoint site for the pipeline's document libraries (dev)
SHAREPOINT_SITE_ALIAS=
SHAREPOINT_SITE_NAME=

# Test's own resources (ADR-0031). AZURE_LOCATION is shared. Test runs must never reach dev's resources.
TEST_AZURE_RESOURCE_GROUP=
TEST_AZURE_STORAGE_ACCOUNT=
TEST_AZURE_FUNCTION_APP=
TEST_AZURE_DOCINTEL=
TEST_SHAREPOINT_SITE_ALIAS=
TEST_SHAREPOINT_SITE_NAME=
