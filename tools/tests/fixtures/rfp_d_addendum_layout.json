   "offset": 624
  },
  {
   "role": null,
   "content": "B.1 THPA-036 is revised to read: \"The system must be available 99.95% of the time, measured monthly.\" (M)",
   "boundingRegions": [
    {
     "pageNumber": 1,
     "polygon": [
