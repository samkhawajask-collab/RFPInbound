     ]
    }
   ],
   "offset": 673
  },
  {
   "role": null,
   "content": "B.2 THPA-010 is deleted in its entirety. Respondents should not respond to this requirement.",
   "boundingRegions": [
    {
     "pageNumber": 1,
     "polygon": [
      1.0671,
      5.5029,
