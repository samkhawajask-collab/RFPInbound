   ],
   "offset": 358
  },
  {
   "role": null,
   "content": "A. 1 The proposal due date is extended from November 24, 2026 to December 8, 2026 at 2:00 p.m. local time.",
   "boundingRegions": [
    {
     "pageNumber": 1,
     "polygon": [
      1.0663,
      3.8311,
      7.3921,
