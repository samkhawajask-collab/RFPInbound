   "offset": 779
  },
  {
   "role": null,
   "content": "B.3 THPA-020 is changed from Desirable (D) to Mandatory (M) . The requirement text is unchanged.",
   "boundingRegions": [
    {
     "pageNumber": 1,
     "polygon": [
