      4.1744
     ]
    }
   ],
   "offset": 393
  },
  {
   "role": null,
   "content": "A.2 Section 3.2 is revised: the technical proposal shall not exceed twenty (20) pages (previously twenty-five (25) pages) .",
   "boundingRegions": [
    {
     "pageNumber": 1,
     "polygon": [
